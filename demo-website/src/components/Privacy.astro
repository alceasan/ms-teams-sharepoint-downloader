<section id="privacy" class="hairline bg-bg-elev">
  <div class="mx-auto max-w-[1280px] px-6 lg:px-10 py-20 lg:py-28">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 mb-14">
      <div class="lg:col-span-4">
        <p class="section-num">05 / privacy &amp; security</p>
      </div>
      <div class="lg:col-span-8">
        <h2 class="section-title">
          It all runs in your browser. <em>Nothing leaves your machine.</em>
        </h2>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 border border-border">
      <div class="p-7 border-b md:border-b-0 md:border-r border-border">
        <div class="flex items-center gap-3 mb-4">
          <span class="font-display text-[2rem] leading-none text-green">/01</span>
          <span class="section-num">local-only</span>
        </div>
        <h3 class="text-fg font-medium text-[14px]">The bytes stay on your machine</h3>
        <p class="mt-2 text-fg-dim text-[13px] leading-[1.6]">
          Segments come from Microsoft&rsquo;s CDN, get decrypted in your
          browser, and go straight to your Downloads folder. There&rsquo;s no
          server in the middle.
        </p>
      </div>

      <div class="p-7 border-b md:border-b-0 md:border-r border-border">
        <div class="flex items-center gap-3 mb-4">
          <span class="font-display text-[2rem] leading-none text-green">/02</span>
          <span class="section-num">no telemetry</span>
        </div>
        <h3 class="text-fg font-medium text-[14px]">No analytics, nothing phoning home</h3>
        <p class="mt-2 text-fg-dim text-[13px] leading-[1.6]">
          The extension only talks to
          <span class="kbd">teams.microsoft.com</span> and
          <span class="kbd">*.sharepoint.com</span> &mdash; the same hosts your
          browser already talks to.
        </p>
      </div>

      <div class="p-7">
        <div class="flex items-center gap-3 mb-4">
          <span class="font-display text-[2rem] leading-none text-green">/03</span>
          <span class="section-num">open source · mit</span>
        </div>
        <h3 class="text-fg font-medium text-[14px]">All the source is on GitHub</h3>
        <p class="mt-2 text-fg-dim text-[13px] leading-[1.6]">
          It&rsquo;s MIT-licensed, with the full source and load-unpacked
          instructions in the README. If you&rsquo;d rather read the code first,
          it&rsquo;s one toggle in <span class="kbd">chrome://extensions</span>.
        </p>
      </div>
    </div>

    <div class="mt-8 border border-border">
      <div class="px-5 py-3 border-b border-border">
        <span class="section-num">tech sheet</span>
      </div>
      <dl class="grid grid-cols-2 md:grid-cols-4 text-[12.5px]">
        <div class="px-5 py-4 border-r border-b md:border-b-0 border-border">
          <dt class="text-fg-faint mb-1">manifest</dt>
          <dd class="text-fg">MV3</dd>
        </div>
        <div class="px-5 py-4 border-r border-b md:border-b-0 border-border">
          <dt class="text-fg-faint mb-1">permissions</dt>
          <dd class="text-fg">storage + host</dd>
        </div>
        <div class="px-5 py-4 border-r border-border">
          <dt class="text-fg-faint mb-1">remote code</dt>
          <dd class="text-fg">none</dd>
        </div>
        <div class="px-5 py-4 border-border">
          <dt class="text-fg-faint mb-1">data sent</dt>
          <dd class="text-fg">0 bytes</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
